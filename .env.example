# Postgres (Supabase transaction pooler, port 6543). The app connects as its own role, schema "app".
DATABASE_URL=postgres://abode_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Used by migrate/seed scripts (session pooler, port 5432)
DIRECT_DATABASE_URL=postgres://abode_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Public base URL used in opt-out links (defaults to the Vercel production URL)
APP_URL=http://localhost:3000
# LLM provider chain, tried in this order; any missing key is skipped
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Demo mode: shows the simulated SMS one-time code on screen and the demo staff logins on the sign-in page.
# Leave unset (off) in a real deployment.
DEMO_MODE=true
# Seed password for demo staff accounts
DEMO_PASSWORD=Demo@1234
